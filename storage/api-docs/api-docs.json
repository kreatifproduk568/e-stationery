{
    "openapi": "3.0.0",
    "info": {
        "title": "E-Stationery API",
        "description": "Dokumentasi REST API aplikasi E-Stationery",
        "version": "1.0.0"
    },
    "paths": {
        "/api/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Memeriksa status API",
                "operationId": "getApiHealth",
                "responses": {
                    "200": {
                        "description": "API berjalan dengan baik",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "E-Stationery API berjalan"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "servers": [
                    {
                        "url": "http://127.0.0.1:8000",
                        "description": "Laravel Development Server"
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Mengambil daftar produk",
                "description": "Mengambil maksimal 10 produk beserta relasi kategori dan merek.",
                "operationId": "getProducts",
                "responses": {
                    "200": {
                        "description": "Data produk berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Data produk berhasil diambil"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "example": "0199a111-2222-7333-8444-555566667777"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Buku Tulis"
                                                    },
                                                    "sku": {
                                                        "type": "string",
                                                        "example": "ATK-001"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "links": {
                                            "type": "object"
                                        },
                                        "meta": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "servers": [
                    {
                        "url": "http://127.0.0.1:8000",
                        "description": "Laravel Development Server"
                    }
                ]
            }
        }
    },
    "tags": [
        {
            "name": "System",
            "description": "System"
        },
        {
            "name": "Products",
            "description": "Products"
        }
    ]
}